        ;; over json.core (ADR: cloud-itonami dependency-substitution wave).
        io.github.kotoba-lang/json {:git/sha "4e33e06b4d66b365d27a51393a16a0acd660f9be"}
        io.github.kotoba-lang/langchain
        {:local/root "../../kotoba-lang/langchain"}
        com.etzhayyim/social-publication
        {:local/root "../../kotoba-lang/social-publication"}}
 :aliases
 {:test
